{
  "name": "el-repuesto",
  "version": "0.1.1",
  "description": "Lee el reporte de El Filtro y te dice qué hacer con cada dependencia problemática: subir de versión o cambiar de paquete. 100% determinístico, sin IA ni API key.",
  "license": "MIT",
  "author": "Juan Carlos Caro (JuanIA-sketch)",
  "repository": { "type": "git", "url": "git+https://github.com/JuanIA-sketch/el-repuesto.git" },
  "homepage": "https://github.com/JuanIA-sketch/el-repuesto#readme",
  "bugs": { "url": "https://github.com/JuanIA-sketch/el-repuesto/issues" },
  "keywords": ["dependencias", "reemplazo", "upgrade", "npm-audit", "deprecated", "abandonado", "cli"],
  "type": "module",
  "bin": { "el-repuesto": "bin/el-repuesto.js" },
  "files": ["bin", "dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
